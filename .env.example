# --- Backend API -------------------------------------------------------------
# Base URL of the backend service that talks to Elasticsearch.
ES_MCP_BACKEND_BASE_URL=http://localhost:8000
# Endpoint paths, if the backend does not use the defaults.
ES_MCP_BACKEND_INDICES_PATH=/indices
# `{method}` is replaced by the retrieval strategy, giving
# /retrieve-bm25, /retrieve-knn, /retrieve-cc and /retrieve-rrf.
ES_MCP_BACKEND_RETRIEVE_PATH_TEMPLATE=/retrieve-{method}

# --- Caller credentials ------------------------------------------------------
# The two keys are NOT configured here: each MCP client sends them as request
# headers and this server forwards them to the backend unchanged. These settings
# only name the headers to read and forward.
ES_MCP_AUTH_HEADER=authorization
ES_MCP_API_KEY_HEADER=x-api-key

# --- HTTP behaviour ----------------------------------------------------------
ES_MCP_REQUEST_TIMEOUT=30.0
ES_MCP_MAX_RETRIES=2
ES_MCP_RETRY_BACKOFF_BASE=0.5

# --- Search defaults ---------------------------------------------------------
ES_MCP_DEFAULT_TOP_K=5
ES_MCP_MAX_TOP_K=50
# bm25 | knn | cc | rrf
ES_MCP_DEFAULT_RETRIEVE_METHOD=rrf
# Permission groups sent when the caller supplies none (JSON list).
ES_MCP_DEFAULT_PERMISSION_GROUPS=["rag-public"]

# --- OpenTelemetry / Elastic APM ---------------------------------------------
# Endpoint, headers, protocol and sampling use the standard OTEL_* variables,
# not ES_MCP_* ones. Setting an endpoint is what switches export on.
#
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://<deployment>.apm.<region>.cloud.es.io:443
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey%20<base64 key>
#
# A self-managed APM Server uses a secret token instead:
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<secret token>
#
# Force export on or off regardless of the endpoint (default: on when set).
# ES_MCP_TELEMETRY_ENABLED=true
ES_MCP_TELEMETRY_SERVICE_NAME=es-search-mcp
# APM "environment" selector, e.g. prod | staging | dev.
# ES_MCP_TELEMETRY_ENVIRONMENT=prod
ES_MCP_TELEMETRY_METRIC_INTERVAL_MS=60000
# Turn off if a log shipper already collects stderr, to avoid double indexing.
ES_MCP_TELEMETRY_EXPORT_LOGS=true
# Print spans and metrics to stderr too. Debugging only.
ES_MCP_TELEMETRY_CONSOLE_EXPORT=false

# --- Observability -----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
ES_MCP_LOG_LEVEL=INFO
# json (machine-readable) | text (human-readable)
ES_MCP_LOG_FORMAT=json
# Log the caller's tool arguments. They contain the end user's search text, so
# set false where queries must not be retained in the log store or in APM.
ES_MCP_LOG_TOOL_ARGUMENTS=true
# Hide internals of unexpected errors from MCP clients.
ES_MCP_MASK_ERROR_DETAILS=true

# --- Transport ---------------------------------------------------------------
# http | sse | stdio
# Credentials arrive as HTTP headers, so stdio cannot supply them.
ES_MCP_TRANSPORT=http
ES_MCP_HOST=127.0.0.1
ES_MCP_PORT=8080
