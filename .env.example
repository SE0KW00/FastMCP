# --- Backend API -------------------------------------------------------------
# Base URL of the backend service that talks to Elasticsearch.
ES_MCP_BACKEND_BASE_URL=http://localhost:8000
# Optional bearer token sent as `Authorization: Bearer ...`.
# ES_MCP_BACKEND_API_KEY=
# Endpoint paths, if the backend does not use the defaults.
ES_MCP_BACKEND_INDICES_PATH=/indices
ES_MCP_BACKEND_RETRIEVE_PATH=/retrieve

# --- HTTP behaviour ----------------------------------------------------------
ES_MCP_REQUEST_TIMEOUT=30.0
ES_MCP_MAX_RETRIES=2
ES_MCP_RETRY_BACKOFF_BASE=0.5

# --- Search defaults ---------------------------------------------------------
ES_MCP_DEFAULT_TOP_K=5
ES_MCP_MAX_TOP_K=50

# --- Observability -----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
ES_MCP_LOG_LEVEL=INFO
# json (machine-readable) | text (human-readable)
ES_MCP_LOG_FORMAT=json
# Hide internals of unexpected errors from MCP clients.
ES_MCP_MASK_ERROR_DETAILS=true

# --- Transport ---------------------------------------------------------------
# stdio | http | sse
ES_MCP_TRANSPORT=stdio
ES_MCP_HOST=127.0.0.1
ES_MCP_PORT=8080
